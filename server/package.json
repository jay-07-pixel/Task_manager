{
  "name": "task-manager-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prisma-generate.mjs",
    "dev": "node --watch-path=./src src/index.js",
    "start": "node src/index.js",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:clear": "node scripts/clear-tasks-lists.mjs",
    "vapid:generate": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.18.1",
    "multer": "^2.1.1",
    "session-file-store": "^1.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.3.0"
  }
}
