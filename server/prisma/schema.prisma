generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  employee
}

enum TaskRecurrence {
  none
  daily
  weekly
  monthly
  yearly
  custom
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  phone        String?  @map("phone") @db.VarChar(32)
  role         Role     @default(employee)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedLists        TaskList[]
  createdTasks      Task[]             @relation("CreatedBy")
  taskAssignments   TaskAssignee[]
  pushSubscriptions PushSubscription[]
  employeeDevices   EmployeeDevice[]
}

model TaskList {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks Task[]
}

model TaskAssignee {
  taskId              String  @map("task_id")
  userId              String  @map("user_id")
  completionProofPath String? @map("completion_proof_path") @db.VarChar(512)
  assigneeDone        Boolean @default(false) @map("assignee_done")
  task                Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignee")
  @@index([userId])
}

model Task {
  id              String           @id @default(uuid())
  listId          String           @map("list_id")
  createdById     String           @map("created_by_id")
  title           String
  notes           String           @db.Text @default("")
  dueAt           DateTime?        @map("due_at")
  allDay          Boolean          @default(false) @map("all_day")
  recurrence      TaskRecurrence   @default(none)
  recurrenceRule  String?          @map("recurrence_rule") @db.Text
  completed       Boolean          @default(false)
  starred         Boolean          @default(false)
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  list         TaskList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("CreatedBy", fields: [createdById], references: [id])
  assignments  TaskAssignee[]

  @@index([listId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique @db.VarChar(768)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model EmployeeDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceId   String   @unique @map("device_id") @db.VarChar(64)
  fcmToken   String   @map("fcm_token") @db.VarChar(512)
  platform   String   @default("android") @db.VarChar(16)
  appVersion String   @map("app_version") @db.VarChar(32)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
  @@map("employee_device")
}

model ReminderSent {
  taskId String   @map("task_id")
  userId String   @map("user_id")
  dueAt  DateTime @map("due_at")
  slot   String   @db.VarChar(16)
  sentAt DateTime @default(now()) @map("sent_at")

  @@id([taskId, userId, dueAt, slot])
  @@map("reminder_sent")
}

model EmailVerification {
  id                String    @id @default(uuid())
  email             String    @unique
  otpHash           String?   @map("otp_hash") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at")
  attempts          Int       @default(0)
  resendCount       Int       @default(0) @map("resend_count")
  resendWindowStart DateTime  @default(now()) @map("resend_window_start")
  verified          Boolean   @default(false)
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("email_verification")
}
