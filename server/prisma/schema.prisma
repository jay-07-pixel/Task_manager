generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  employee
}

enum TaskRecurrence {
  none
  daily
  weekly
  monthly
  yearly
  custom
}

enum TaskProgressUpdateType {
  started
  in_progress
  blocked
  update
}

enum AttendanceCheckType {
  check_in
  check_out
}

enum TaskDeadlineExtensionStatus {
  pending
  approved
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  phone        String?  @map("phone") @db.VarChar(32)
  role         Role     @default(employee)
  isAdmin      Boolean  @default(false) @map("is_admin")
  isOwner      Boolean  @default(false) @map("is_owner")
  salary       Int      @default(15000)
  profilePhotoPath String? @map("profile_photo_path") @db.VarChar(512)
  profilePhotoMime String? @map("profile_photo_mime") @db.VarChar(128)
  profilePhotoName String? @map("profile_photo_name") @db.VarChar(255)
  idProofPath      String? @map("id_proof_path") @db.VarChar(512)
  idProofMime      String? @map("id_proof_mime") @db.VarChar(128)
  idProofName      String? @map("id_proof_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedLists        TaskList[]
  createdTasks      Task[]             @relation("CreatedBy")
  taskAssignments           TaskAssignee[]       @relation("TaskAssigneeUser")
  taskAssignmentsDelegated  TaskAssignee[]       @relation("TaskAssignedBy")
  delegationsFrom           TaskDelegation[]     @relation("DelegationFrom")
  delegationsTo             TaskDelegation[]     @relation("DelegationTo")
  pushSubscriptions         PushSubscription[]
  employeeDevices           EmployeeDevice[]
  taskProgressUpdates       TaskProgressUpdate[]
  taskProgressUpdateReads   TaskProgressUpdateRead[]
  chatConversationsLow      ChatConversation[] @relation("ChatLow")
  chatConversationsHigh     ChatConversation[] @relation("ChatHigh")
  chatMessagesSent          ChatMessage[]
  chatGroupsCreated         ChatGroup[]        @relation("ChatGroupCreatedBy")
  chatGroupMemberships      ChatGroupMember[]
  chatGroupMessagesSent     ChatGroupMessage[]
  locationPreference        EmployeeLocationPreference?
  locationPings             EmployeeLocationPing[]
  locationOffPeriods        EmployeeLocationOffPeriod[]
  attendanceChecks          AttendanceCheck[]
  deadlineExtensionRequests TaskDeadlineExtensionRequest[] @relation("DeadlineExtensionEmployee")
  deadlineExtensionsApproved TaskDeadlineExtensionRequest[] @relation("DeadlineExtensionApprovedBy")
}

model TaskList {
  id        String    @id @default(uuid())
  ownerId   String    @map("owner_id")
  title     String
  sortOrder Int       @default(0) @map("sort_order")
  pinned    Boolean   @default(false)
  pinnedAt  DateTime? @map("pinned_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([ownerId])
}

model TaskAssignee {
  taskId              String    @map("task_id")
  userId              String    @map("user_id")
  assignedByUserId    String?   @map("assigned_by_user_id")
  delegatedAt         DateTime? @map("delegated_at")
  completionProofPath String?   @map("completion_proof_path") @db.VarChar(512)
  submissionText      String?   @map("submission_text") @db.Text
  assigneeDone             Boolean   @default(false) @map("assignee_done")
  lastSubmittedAt          DateTime? @map("last_submitted_at")
  archivedSubmittedAt      DateTime? @map("archived_submitted_at")
  lastSubmissionText       String?   @map("last_submission_text") @db.Text
  lastCompletionProofPath  String?   @map("last_completion_proof_path") @db.VarChar(512)
  task                Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                User      @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy          User?     @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  submissionProofs    TaskSubmissionProof[]

  @@id([taskId, userId])
  @@map("task_assignee")
  @@index([userId])
  @@index([assignedByUserId])
}

model TaskSubmissionProof {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  filePath  String   @map("file_path") @db.VarChar(512)
  sortOrder Int      @default(0) @map("sort_order")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  assignee TaskAssignee @relation(fields: [taskId, userId], references: [taskId, userId], onDelete: Cascade)

  @@index([taskId, userId, archived])
  @@map("task_submission_proof")
}

model TaskDelegation {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser User @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_delegation")
}

model Task {
  id              String           @id @default(uuid())
  listId          String           @map("list_id")
  createdById     String           @map("created_by_id")
  title           String
  notes           String           @db.Text
  dueAt           DateTime?        @map("due_at")
  dueTimeZone     String?          @map("due_time_zone") @db.VarChar(64)
  allDay          Boolean          @default(false) @map("all_day")
  recurrence      TaskRecurrence   @default(none)
  recurrenceRule  String?          @map("recurrence_rule") @db.Text
  completed       Boolean          @default(false)
  starred         Boolean          @default(false)
  highPriority    Boolean          @default(false) @map("high_priority")
  durationMinutes        Int?             @map("duration_minutes")
  reminderBeforeMinutes  Int?             @map("reminder_before_minutes")
  sortOrder              Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  list            TaskList             @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("CreatedBy", fields: [createdById], references: [id])
  assignments            TaskAssignee[]
  delegations            TaskDelegation[]
  progressUpdates        TaskProgressUpdate[]
  progressUpdateReads    TaskProgressUpdateRead[]
  assignmentAttachments  TaskAssignmentAttachment[]
  deadlineExtensionRequests TaskDeadlineExtensionRequest[]

  @@index([listId])
  @@index([listId, completed])
}

model TaskDeadlineExtensionRequest {
  id               String                      @id @default(uuid())
  taskId           String                      @map("task_id")
  employeeUserId   String                      @map("employee_user_id")
  requestedAt      DateTime                    @default(now()) @map("requested_at")
  status           TaskDeadlineExtensionStatus @default(pending)
  approvedAt       DateTime?                   @map("approved_at")
  approvedByUserId String?                     @map("approved_by_user_id")
  newDueAt         DateTime?                   @map("new_due_at")

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   User  @relation("DeadlineExtensionEmployee", fields: [employeeUserId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("DeadlineExtensionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([taskId, employeeUserId])
  @@index([status])
  @@map("task_deadline_extension_request")
}

model TaskAssignmentAttachment {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  filePath     String   @map("file_path") @db.VarChar(512)
  mimeType     String   @map("mime_type") @db.VarChar(128)
  kind         String   @map("kind") @db.VarChar(16)
  originalName String?  @map("original_name") @db.VarChar(255)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_assignment_attachment")
}

model TaskProgressUpdate {
  id         String                 @id @default(uuid())
  taskId     String                 @map("task_id")
  userId     String                 @map("user_id")
  updateType TaskProgressUpdateType @map("update_type")
  message    String                 @db.Text
  createdAt  DateTime               @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, userId])
  @@map("task_progress_update")
}

model TaskProgressUpdateRead {
  taskId         String   @map("task_id")
  assigneeUserId String   @map("assignee_user_id")
  ownerId        String   @map("owner_id")
  lastReadAt     DateTime @map("last_read_at")

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([taskId, assigneeUserId, ownerId])
  @@map("task_progress_update_read")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique @db.VarChar(768)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model EmployeeDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceId   String   @unique @map("device_id") @db.VarChar(64)
  fcmToken   String   @map("fcm_token") @db.VarChar(512)
  platform   String   @default("android") @db.VarChar(16)
  appVersion String   @map("app_version") @db.VarChar(32)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
  @@map("employee_device")
}

model EmployeeLocationPreference {
  userId          String    @id @map("user_id")
  consentAt       DateTime? @map("consent_at")
  trackingEnabled Boolean   @default(false) @map("tracking_enabled")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_location_preference")
}

model EmployeeLocationPing {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime @default(now()) @map("recorded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("employee_location_ping")
}

model EmployeeLocationOffPeriod {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  reason    String    @db.VarChar(32)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("employee_location_off_period")
}

model WorkLocation {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(100) @map("radius_meters")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  attendanceChecks AttendanceCheck[]

  @@map("work_location")
}

model AttendanceCheck {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  type           AttendanceCheckType
  latitude       Float
  longitude      Float
  workLocationId String?             @map("work_location_id")
  distanceMeters Float               @map("distance_meters")
  withinRadius   Boolean             @map("within_radius")
  timingStatus   String?             @map("timing_status") @db.VarChar(16)
  recordedAt     DateTime            @default(now()) @map("recorded_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([recordedAt])
  @@map("attendance_check")
}

model ReminderSent {
  taskId       String   @map("task_id")
  userId       String   @map("user_id")
  dueAt        DateTime @map("due_at")
  slot         String   @db.VarChar(16)
  channel      String   @default("web_push") @db.VarChar(16)
  status       String   @default("sent") @db.VarChar(16)
  messageId    String?  @map("message_id") @db.VarChar(128)
  errorMessage String?  @map("error_message") @db.Text
  sentAt       DateTime @default(now()) @map("sent_at")

  @@id([taskId, userId, dueAt, slot, channel])
  @@map("reminder_sent")
}

model PasswordReset {
  id                String    @id @default(uuid())
  email             String    @unique
  otpHash           String?   @map("otp_hash") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at")
  attempts          Int       @default(0)
  resendCount       Int       @default(0) @map("resend_count")
  resendWindowStart DateTime  @default(now()) @map("resend_window_start")
  verified          Boolean   @default(false)
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("password_reset")
}

model ChatConversation {
  id         String   @id @default(uuid())
  userLowId  String   @map("user_low_id")
  userHighId String   @map("user_high_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userLow  User          @relation("ChatLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User          @relation("ChatHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@map("chat_conversation")
}

model ChatMessage {
  id               String    @id @default(uuid())
  conversationId   String    @map("conversation_id")
  senderId         String    @map("sender_id")
  body             String    @db.Text
  attachmentPath   String?   @map("attachment_path") @db.VarChar(255)
  attachmentMime   String?   @map("attachment_mime") @db.VarChar(128)
  attachmentName   String?   @map("attachment_name") @db.VarChar(255)
  replyToMessageId     String?   @map("reply_to_message_id")
  forwardedFromName    String?   @map("forwarded_from_name") @db.VarChar(120)
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  readAt               DateTime? @map("read_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      ChatMessage?     @relation("ChatMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]    @relation("ChatMessageReply")

  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@map("chat_message")
}

model ChatGroup {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(80)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User              @relation("ChatGroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members   ChatGroupMember[]
  messages  ChatGroupMessage[]

  @@index([createdById])
  @@map("chat_group")
}

model ChatGroupMember {
  groupId    String    @map("group_id")
  userId     String    @map("user_id")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("chat_group_member")
}

model ChatGroupMessage {
  id               String    @id @default(uuid())
  groupId          String    @map("group_id")
  senderId         String    @map("sender_id")
  body             String    @db.Text
  attachmentPath   String?   @map("attachment_path") @db.VarChar(255)
  attachmentMime   String?   @map("attachment_mime") @db.VarChar(128)
  attachmentName   String?   @map("attachment_name") @db.VarChar(255)
  replyToMessageId  String?   @map("reply_to_message_id")
  forwardedFromName String?   @map("forwarded_from_name") @db.VarChar(120)
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  group   ChatGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender  User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo ChatGroupMessage?   @relation("ChatGroupMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies ChatGroupMessage[] @relation("ChatGroupMessageReply")

  @@index([groupId, createdAt])
  @@index([replyToMessageId])
  @@map("chat_group_message")
}

model EmailVerification {
  id                String    @id @default(uuid())
  email             String    @unique
  otpHash           String?   @map("otp_hash") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at")
  attempts          Int       @default(0)
  resendCount       Int       @default(0) @map("resend_count")
  resendWindowStart DateTime  @default(now()) @map("resend_window_start")
  verified          Boolean   @default(false)
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("email_verification")
}

model CompanySettings {
  id                   String   @id @default("default")
  trialStartDate       DateTime @map("trial_start_date")
  trialEndDate         DateTime @map("trial_end_date")
  liveLocationRequired Boolean  @default(true) @map("live_location_required")
  attendanceEnabled    Boolean  @default(false) @map("attendance_enabled")
  dailyCheckInTime     String?  @map("daily_check_in_time") @db.VarChar(5)
  dailyCheckOutTime    String?  @map("daily_check_out_time") @db.VarChar(5)
  companyName          String?  @map("company_name") @db.VarChar(200)
  companyAddress       String?  @map("company_address") @db.Text
  companyState         String?  @map("company_state") @db.VarChar(64)
  gstNumber            String?  @map("gst_number") @db.VarChar(32)
  gstCertificatePath   String?  @map("gst_certificate_path") @db.VarChar(512)
  gstCertificateMime   String?  @map("gst_certificate_mime") @db.VarChar(128)
  gstCertificateName   String?  @map("gst_certificate_name") @db.VarChar(255)
  directorName         String?  @map("director_name") @db.VarChar(120)
  directorEmail        String?  @map("director_email") @db.VarChar(191)
  directorPhone        String?  @map("director_phone") @db.VarChar(32)
  directorDetails      String?  @map("director_details") @db.Text
  contactPerson2Name   String?  @map("contact_person2_name") @db.VarChar(120)
  contactPerson2Email  String?  @map("contact_person2_email") @db.VarChar(191)
  contactPerson2Phone  String?  @map("contact_person2_phone") @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}
