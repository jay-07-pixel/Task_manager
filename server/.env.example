DATABASE_URL="mysql://root:password@localhost:3306/taskmanager"
SESSION_SECRET="change-this-to-a-long-random-string"

# Production on HTTP (e.g. http://148.x.x.x:3000) — required or login cookie will not save
COOKIE_SECURE=false

# Optional: if UI and API are on different origins (comma-separated)
# CLIENT_ORIGIN="http://148.135.137.159:5173,http://148.135.137.159:3000"

# Optional: behind nginx/reverse proxy
# TRUST_PROXY=true

# Session lifetime (ms). Default in code is ~10 years (until manual logout).
# SESSION_MAX_AGE_MS=315360000000

# DEBUG_REMINDERS=true
# DEBUG_PUSH=true

# Phone push reminders (server sends alerts even when user is in other apps)
# Generate keys: npm run vapid:generate --prefix server
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Email OTP (registration) — Brevo Transactional API (https://www.brevo.com)
# In development without Brevo configured, OTP is logged to the server console.
# BREVO_API_KEY="xkeysib-..."
# BREVO_SENDER_NAME="Task Manager"
# BREVO_SENDER_EMAIL="noreply@yourdomain.com"

# Optional: public website URL included in admin promotion emails
# APP_PUBLIC_URL="https://sugandhshoppee.kalpanik.in"

# Cloudflare Turnstile (registration CAPTCHA)
# Create keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Android FCM (Firebase Admin) — device registration, test push, scheduled task reminders
# Download service account JSON from Firebase Console → Project settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT_PATH="firebase-service-account.json"
# Or paste minified JSON (one line) as FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Fallback IANA timezone for reminder due-time text when task.due_time_zone is null (legacy tasks)
# APP_TIMEZONE="Asia/Kolkata"

# Company free trial (per database — set in each VPS instance's server/.env)
# See deploy/company-trial-env.example for Task_manager, safari, ss2n, acs, tacs values.
# COMPANY_TRIAL_START=2026-06-15
# COMPANY_TRIAL_END=2026-07-15
