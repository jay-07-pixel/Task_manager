# Include inside the server { } block for each Task Manager site
# (e.g. sugandhshoppee.kalpanik.in, safari.kalpanik.in, ss2n.kalpanik.in).
#
# Nginx default is 1m — uploads will fail with 413 Request Entity Too Large.
#
#   sudo nano /etc/nginx/sites-available/YOUR_SITE
#   add inside server { }:  client_max_body_size 0;
#   sudo nginx -t && sudo systemctl reload nginx
#
# Task submission photos/videos: no size cap in the app (any size).
# client_max_body_size 0 = unlimited request body in nginx.
# Chat attachments remain limited to 5 MB in the application.

client_max_body_size 0;

